# ПРОИЗВОДНОЕ НЕ ХРАНИТСЯ, ИБО ОНО ВОСПРОИЗВОДИМО.
#
# Байт-код Python рождается заново при каждом запуске и меняется при
# каждом. В истории его не было смысла с первого дня: 105 файлов
# .pyc шумели в каждом `git status`, попадали в чужие `git add -A`
# параллельных сессий и заставляли читать diff, где нечего читать.
#
# Здесь перечислено только ПРОИЗВОДНОЕ. Всё, что рождено прибором и
# ЯВЛЯЕТСЯ ЗАМЕРОМ (datasets/*.txt, declarations/BAND-WALLS.md),
# хранится и должно храниться: замер есть свидетельство, а не мусор,
# и по нему сверяют, что корпус не уехал молча.

# байт-код и кэши
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# среды
.venv/
venv/
*.egg-info/

# следы файловых менеджеров
.DS_Store
Thumbs.db

# временное рабочее
*.tmp
# ВРЕМЕННЫЙ ФАЙЛ ВОРОТ (12.09). `layer._ворота` пишет страницы в «<мир>.ворота», даёт их
# палате и снимает файл в `finally`. Ковка, снятая сигналом между записью и снятием,
# оставляет его в дереве — и он был ПОЛОЖЕН в свод вместе с честной правкой, ибо `git add -A`
# не спрашивает, чей это файл.
#
#     ВРЕМЕННОЕ, НЕ НАЗВАННОЕ ВРЕМЕННЫМ, СТАНОВИТСЯ ПОСТОЯННЫМ ПРИ ПЕРВОМ ЖЕ СБОЕ.
*.ворота
*.bak
*.orig
*.rej

# сборка для одного суда органа обращения: выводится из полного свода
# генератором tools/gen_genesis_holdout.py и умирает с судом — не канон
datasets/GENESIS-HOLDOUT.txt
datasets/GENESIS-SCHOOL-PERMUTED.txt
